#ifndef OTROBOPT_EXPERIMENTESTIMATOR_HXX
#define OTROBOPT_EXPERIMENTESTIMATOR_HXX

#include "otrobopt/ProbabilityEstimatorImplementation.hxx"
#include <openturns/WeightedExperiment.hxx>

namespace OTROBOPT
{

/**
 * @class ExperimentEstimator
 *
 * Sampling estimator of a system-event probability.
 *
 * The probability is the weighted mean of the Boolean predicate evaluated on
 * the indicators of the limit-state components over the sample generated by
 * the experiment.  The weights are normalized by their sum, which defines the
 * empirical measure.
 *
 * The error estimate is the binomial standard error at the effective sample
 * size 1 / sum(w_i^2).  It is exact for independent Monte Carlo sampling and
 * conservative for low-discrepancy or Latin hypercube sampling, whose true
 * variance is lower.  It is NaN when the effective sample size does not
 * exceed one.
 */
class OTROBOPT_API ExperimentEstimator
  : public ProbabilityEstimatorImplementation
{
  CLASSNAME

public:
  /** Default constructor */
  ExperimentEstimator();

  /** Constructor from a weighted experiment */
  explicit ExperimentEstimator(const OT::WeightedExperiment & experiment);

  /** Virtual constructor method */
  ExperimentEstimator * clone() const override;

  /** Experiment accessor */
  void setExperiment(const OT::WeightedExperiment & experiment);
  OT::WeightedExperiment getExperiment() const;

  /** String converter */
  OT::String __repr__() const override;

  /** Method save() stores the object through the StorageManager */
  void save(OT::Advocate & adv) const override;

  /** Method load() reloads the object from the StorageManager */
  void load(OT::Advocate & adv) override;

protected:
  /** Probability implementation */
  OT::Scalar computeSafeProbability(const OT::Function & predicate,
                                    const OT::Function & limitState,
                                    const OT::Distribution & distribution,
                                    const OT::Point & designPoint) const override;

  /** Error implementation */
  OT::Scalar computeEstimationError(const OT::Function & predicate,
                                    const OT::Function & limitState,
                                    const OT::Distribution & distribution,
                                    const OT::Point & designPoint) const override;

private:
  /** Probability and normalized empirical weights */
  OT::Scalar evaluate(const OT::Function & predicate,
                      const OT::Function & limitState,
                      const OT::Distribution & distribution,
                      const OT::Point & designPoint,
                      OT::Point & weights) const;

  OT::WeightedExperiment experiment_;

}; /* class ExperimentEstimator */

} /* namespace OTROBOPT */

#endif /* OTROBOPT_EXPERIMENTESTIMATOR_HXX */
